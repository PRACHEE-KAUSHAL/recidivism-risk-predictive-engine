"""
Recidivism Risk Predictive Engine
Author: Prachi Kaushal
Description: Binary classification pipeline evaluating behavioral indicators
             to predict re-offense risk using Scikit-Learn.
"""

import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, roc_auc_score

def generate_risk_dataset(n_samples=1000):
    np.random.seed(42)
    age = np.random.randint(18, 65, size=n_samples)
    priors_count = np.random.poisson(lam=2.5, size=n_samples)
    juvenile_felonies = np.random.binomial(n=3, p=0.15, size=n_samples)
    offense_severity = np.random.choice([1, 2, 3], size=n_samples, p=[0.5, 0.35, 0.15])
    
    # Behavioral risk formula for target generation
    risk_score = (priors_count * 0.4) + (juvenile_felonies * 0.8) + (offense_severity * 0.3) - (age * 0.03)
    prob = 1 / (1 + np.exp(-risk_score))
    recidivism = (prob > 0.45).astype(int)
    
    df = pd.DataFrame({
        "Age": age,
        "Prior_Convictions": priors_count,
        "Juvenile_Felonies": juvenile_felonies,
        "Offense_Severity": offense_severity,
        "Recidivism_2yr": recidivism
    })
    return df

def train_and_evaluate(df):
    X = df.drop(columns=["Recidivism_2yr"])
    y = df["Recidivism_2yr"]
    
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)
    
    model = RandomForestClassifier(n_estimators=100, max_depth=5, random_state=42)
    model.fit(X_train, y_train)
    
    y_pred = model.predict(X_test)
    y_prob = model.predict_proba(X_test)[:, 1]
    
    print("\n=== Model Performance ===")
    print(f"ROC-AUC Score: {roc_auc_score(y_test, y_prob):.4f}")
    print("\nClassification Report:\n", classification_report(y_test, y_pred))
    
    print("=== Feature Importances (Behavioral Weights) ===")
    for feature, importance in zip(X.columns, model.feature_importances_):
        print(f"  - {feature}: {importance * 100:.2f}%")

if __name__ == "__main__":
    print("[*] Generating behavioral dataset and training predictive risk model...")
    df = generate_risk_dataset()
    train_and_evaluate(df)
